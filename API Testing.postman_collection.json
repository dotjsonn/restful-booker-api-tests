    {
      "name": "Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"id\");\npm.variables.set(\"id\", \"\");\n\npm.test(\"Create returns 200\", () => {\n    pm.response.to.have.status(200);\n});\n\nlet createdResponse;\n\npm.test(\"Created booking matches the request body\", () => {\n    createdResponse = pm.response.json();\n\n    const expected = JSON.parse(\n        pm.variables.replaceIn(pm.request.body.raw)\n    );\n\n    pm.expect(createdResponse.booking).to.deep.eql(expected);\n});\n\nif (\n    pm.response &&\n    pm.response.code === 200 &&\n    createdResponse &&\n    Number.isInteger(createdResponse.bookingid) &&\n    createdResponse.bookingid > 0\n) {\n    pm.collectionVariables.set(\"id\", createdResponse.bookingid);\n    pm.variables.set(\"id\", createdResponse.bookingid);\n} else {\n    pm.execution.setNextRequest(null);\n}"
            ]
          }
        }
