  "item": [
    {
      "name": "Auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "[\"token\", \"id\", \"expectedBooking\"].forEach((key) => {\n    pm.collectionVariables.unset(key);\n    pm.variables.set(key, \"\");\n});\n\npm.test(\"Auth returns 200\", () => {\n    pm.response.to.have.status(200);\n});\n\nlet authResponse;\n\npm.test(\"Auth returns a non-empty token\", () => {\n    authResponse = pm.response.json();\n\n    pm.expect(authResponse.token).to.be.a(\"string\");\n    pm.expect(authResponse.token.trim()).to.not.be.empty;\n});\n\nif (\n    pm.response &&\n    pm.response.code === 200 &&\n    authResponse &&\n    typeof authResponse.token === \"string\" &&\n    authResponse.token.trim()\n) {\n    pm.collectionVariables.set(\"token\", authResponse.token);\n    pm.variables.set(\"token\", authResponse.token);\n} else {\n    pm.execution.setNextRequest(null);\n}"
            ]
          }
        }
      ],
